## Frontend environment variables (Vite)
#
# Local development:
# - Start backend locally (usually http://localhost:5000)
# - Copy this file to .env.local (recommended) or .env
# - Set VITE_API_URL to your backend URL
#
# VPS (build on server or CI before upload):
# - VITE_API_URL=https://api.yourdomain.com   (must be public HTTPS in production)
# - VITE_SITE_URL=https://yourdomain.com
#
# The legacy REACT_APP_API_URL / REACT_APP_SITE_URL names (Create React App) are still read as a
# fallback, so existing environments keep working.
VITE_API_URL=http://localhost:5000
VITE_SITE_URL=http://localhost:3000

# Admin portal preview (sidebar + dashboard links to /student, /teacher, etc. while logged in as admin).
# ON by default in dev and production builds. To hide on live site, set before build:
# VITE_ADMIN_PORTAL_PREVIEW=false
