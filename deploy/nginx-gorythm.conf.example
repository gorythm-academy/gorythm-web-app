# Example Nginx config: React static site + Express API on the same VPS.
#
# Replace:
#   yourdomain.com      → main site (serves build/)
#   api.yourdomain.com  → reverse proxy to Node (PM2 on 127.0.0.1:5000)
#
# Paths:
#   Adjust root to where `npm run build` output lives (usually .../build).
#   Adjust the certificate paths after Certbot creates them.
#
# Install:
#   sudo cp deploy/nginx-gorythm.conf.example /etc/nginx/sites-available/gorythm
#   sudo ln -s /etc/nginx/sites-available/gorythm /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Certificates (after DNS points here). Create them before reloading this file:
#   sudo certbot certonly --webroot -w /var/www/certbot \
#     -d yourdomain.com -d www.yourdomain.com -d api.yourdomain.com
#
# Compression (often also in nginx.conf http {}):
#   gzip on;
#   gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;
# Brotli (optional, needs ngx_brotli): same idea with brotli_types.
#
# Cache: the Vite build emits content-hashed filenames under /static/ — safe to cache "forever".
# index.html must stay short-cache or no-cache so users pick up new chunk names.
# Use ^~ so these prefixes win over a generic regex `location ~* \.(js|css|...)$` block.

upstream gorythm_api {
    server 127.0.0.1:5000;
    keepalive 64;
}

# ---- HTTP: certificate renewal + redirect to HTTPS ----
server {
    listen 80;
    listen [::]:80;
    server_name yourdomain.com www.yourdomain.com api.yourdomain.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---- Main site (React SPA) ----
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name yourdomain.com www.yourdomain.com;

    ssl_certificate /etc/letsencrypt/live/yourdomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yourdomain.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:GorythmSSL:10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    root /var/www/gorythm/build;
    index index.html;

    # Single Page App shell — never long-cache HTML (new deploy = new hashed assets)
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    # Hashed JS/CSS/media from `npm run build` (Vite) (PageSpeed: long cache TTL)
    location ^~ /static/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        try_files $uri =404;
    }

    # Public raster/video (filenames may be unhashed — bump file or ?v= on change)
    location ^~ /images/ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, stale-while-revalidate=86400";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        try_files $uri =404;
    }

    location ^~ /preload/ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, stale-while-revalidate=86400";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        try_files $uri =404;
    }

    location ^~ /video/ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, stale-while-revalidate=86400";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        try_files $uri =404;
    }

    # Short cache for manifest / favicon (swap filenames when branding changes)
    location = /manifest.json {
        add_header Cache-Control "public, max-age=3600";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        try_files $uri =404;
    }

    # API on same host (production uses https://gorythmacademy.com/api/...)
    location /api/ {
        client_max_body_size 25m;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_pass http://gorythm_api;
    }

    # Uploaded LMS files (PDFs, etc.)
    location /api/uploads/ {
        client_max_body_size 25m;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_pass http://gorythm_api;
    }

    # Single Page App: all non-file routes → index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ---- API (Express) ----
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.yourdomain.com;

    # Same certificate as the site when Certbot issued one cert for all three names.
    ssl_certificate /etc/letsencrypt/live/yourdomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yourdomain.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;

    client_max_body_size 25m;

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_pass http://gorythm_api;
    }
}
