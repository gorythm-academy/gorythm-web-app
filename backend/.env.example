# Backend (Express) — copy to .env on the server. Never commit .env.

NODE_ENV=production
PORT=5000

# Reverse-proxy hops for Express (nginx, ALB, Vercel). Omit to use default (1 hop).
# TRUST_PROXY=2  → two proxies in front of Node
# TRUST_PROXY=0  → Node exposed directly (no trusted reverse proxy)

# Must match the browser origin of your React app (no trailing slash).
# Example: https://yourdomain.com
FRONTEND_URL=

# Include database name in the path, e.g. ...mongodb.net/gorythm_academy?ssl=true...
# Without a db name, Mongoose defaults to `test` (empty) while live data may be elsewhere.
MONGODB_URI=

# Required. Min 32 chars in production, 16 in development.
JWT_SECRET=
JWT_EXPIRES_SESSION=12h
JWT_EXPIRES_REMEMBER=30d

# Optional first boot — both email and password required to seed; no default password.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: comma-separated Stripe payment_method_types override
# STRIPE_CHECKOUT_PAYMENT_METHOD_TYPES=card

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
CONTACT_INBOX_EMAIL=

# Academy weekend is Sunday only (configured in teacherAttendanceCalendar.js).

# Persistent folder for uploaded files (payment proofs, course images, video thumbnails, etc.).
# Required on production VPS — without this, uploads live under backend/uploads and are lost on redeploy
# unless you mount a volume at that path. Example: UPLOAD_ROOT=/var/data/gorythm/uploads
# UPLOAD_ROOT=

# Serverless only; leave unset on VPS
# VERCEL=
