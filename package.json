{
  "name": "gorythm-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.2.5",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@vimeo/player": "^2.30.4",
    "axios": "^1.20.0",
    "dompurify": "^3.4.16",
    "framer-motion": "^12.23.26",
    "gsap": "^3.12.5",
    "jspdf": "^4.2.1",
    "libphonenumber-js": "^1.13.15",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.18.4",
    "sass": "^1.97.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:js": "npx eslint \"src/**/*.{js,jsx}\"",
    "lint:styles": "npx stylelint \"src/**/*.scss\"",
    "lint": "npm run lint:js && npm run lint:styles",
    "optimize-images": "node scripts/generate-modern-image-variants.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "overrides": [
      {
        "files": [
          "**/*.test.{js,jsx}",
          "src/setupTests.js"
        ],
        "env": {
          "jest": true
        },
        "globals": {
          "vi": "readonly"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react-app": "^7.0.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.30",
    "sharp": "^0.34.5",
    "stylelint": "^17.6.0",
    "stylelint-config-recommended-scss": "^17.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "description": "Frontend application for the Gorythm platform.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farhanullah31/gorythm_client.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/farhanullah31/gorythm_client/issues"
  }
}
